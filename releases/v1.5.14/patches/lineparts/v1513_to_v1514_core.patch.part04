@@ -0,0 +1,24 @@
+const fs=require('fs'),path=require('path'),assert=require('assert');
+const root=path.join(__dirname,'..');
+const install=fs.readFileSync(path.join(root,'desktop/install.command'),'utf8');
+const verify=fs.readFileSync(path.join(root,'desktop/verify_mac_smoke.command'),'utf8');
+for(const token of [
+  'HOST_IDENTITY_SCHEME="AD_HOC_STABLE_CUSTOM_DR_V1"',
+  'HOST_STABLE_REQUIREMENT=',
+  'designated => identifier "com.sidedock.desktop"',
+  'info[CFBundleIdentifier] = "com.sidedock.desktop"',
+  'HOST_IDENTITY_REPAIR=1',
+  'weak v1.5.13 H1 signing identity detected',
+  'codesign --force --deep --sign -',
+  'codesign --force --sign - --requirements "=$HOST_STABLE_REQUIREMENT"',
+  'codesign --verify --deep --strict -R "=$HOST_STABLE_REQUIREMENT"',
+  'designatedRequirementStable',
+  'hostIdentityRepair',
+  'hostIdentityScheme'
+]) assert(install.includes(token),token);
+assert(install.includes('an authorized H1 Host is already recorded; ordinary installers must never replace it.'),'ordinary authorized H1 migration protection must remain');
+assert(install.includes('[ "$HOST_IDENTITY_REPAIR" -ne 1 ]'),'only the explicit weak-identity repair may bypass the ordinary H1 migration refusal');
+assert(!/tccutil\s+reset/i.test(install),'installer must never reset user TCC decisions');
+assert(verify.includes('AD_HOC_STABLE_CUSTOM_DR_V1')&&verify.includes('designatedRequirementStable'),'real-Mac gate must verify stable H1 signing identity');
+assert(verify.includes('identifier "com.sidedock.desktop"')&&verify.includes('info[CFBundleIdentifier]'),'real-Mac gate must verify the full SideDock custom designated requirement');
+console.log('PASS v1.5.14 H1 stable designated-requirement identity repair contract');
