+++ b/tests/test_v1514_native_command_circuit.js
@@ -0,0 +1,18 @@
+const assert=require('assert');
+const {NativeBridgeServer}=require('../desktop/app/src/bridge/native-server');
+(async()=>{
+  const s=new NativeBridgeServer({version:'1.5.14'});
+  s.primary={destroyed:false,_authorized:true,write(){return true;}};
+  s.send=()=>true;
+  const started=Date.now();
+  const first=await s.request('capture-active-page',{requestId:'stall-1'},350);
+  assert.equal(first.ok,false); assert.equal(first.code,'NATIVE_ADAPTER_TIMEOUT');
+  assert(Date.now()-started>=300,'test must exercise the command timeout rather than an immediate offline path');
+  assert(s.commandCircuitOpenUntil>Date.now(),'a timed-out command must open the short circuit');
+  assert.equal(s.commandChannelHealthy(),false,'connected socket with open command circuit is not healthy');
+  const second=await s.request('capture-active-page',{requestId:'stall-2'},350);
+  assert.equal(second.code,'NATIVE_COMMAND_CIRCUIT_OPEN','subsequent commands must bypass the stalled native channel immediately');
+  const d=s.diagnostics();
+  assert.equal(d.connected,true); assert.equal(d.commandHealthy,false); assert.equal(d.commandCircuitOpen,true); assert(d.consecutiveCommandFailures>=1);
+  console.log('PASS v1.5.14 Native connected-but-stalled command circuit behavior');
+})().catch(e=>{console.error(e);process.exit(1)});
