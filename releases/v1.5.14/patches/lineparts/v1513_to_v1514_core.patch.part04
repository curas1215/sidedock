+++ b/tests/test_v1514_browser_transport_hedge.js
@@ -0,0 +1,17 @@
+const fs=require('fs'),path=require('path'),assert=require('assert');
+const root=path.join(__dirname,'..');
+const background=fs.readFileSync(path.join(root,'chrome_extension/background.js'),'utf8');
+const main=fs.readFileSync(path.join(root,'desktop/app/src/main.js'),'utf8');
+const nativeCode=fs.readFileSync(path.join(root,'desktop/app/src/bridge/native-server.js'),'utf8');
+const start=background.indexOf('async function startBrowserCommandLoop');
+const end=background.indexOf('// Native Messaging is the primary',start);
+const loop=background.slice(start,end>start?end:start+4000);
+assert(start>=0,'browser command loop missing');
+assert(loop.includes('getNextCommand(18000)'),'HTTP command long-poll must stay armed');
+assert(!loop.includes('nativeDiagnostics?.().connected'),'native socket connection alone must never suppress HTTP command fallback');
+for(const token of ['commandChannelHealthy','commandCircuitOpenUntil','NATIVE_COMMAND_CIRCUIT_OPEN','consecutiveCommandFailures','lastCommandLatencyMs']) assert(nativeCode.includes(token),token);
+assert(main.includes('350))'),'native-first transport must hedge to HTTP after 350ms');
+assert(main.includes('http_hedged_fallback')&&main.includes('http_fast_failover')&&main.includes('http_circuit_bypass'),'all fast failover states must be observable');
+assert(main.includes('const shared = { ...options, requestId }'),'native and HTTP transports must share one requestId');
+assert(background.includes("dedupCode: 'REQUEST_DEDUP_HIT_RUNNING'")&&background.includes("dedupCode: 'REQUEST_DEDUP_HIT_RESULT'"),'extension must deduplicate hedged commands');
+console.log('PASS v1.5.14 browser command health + 350ms hedged HTTP fallback contract');
