+const fs=require('fs'),path=require('path'),assert=require('assert');const root=path.join(__dirname,'..');
+const pkg=JSON.parse(fs.readFileSync(path.join(root,'desktop/app/package.json'),'utf8'));
+const ext=JSON.parse(fs.readFileSync(path.join(root,'chrome_extension/manifest.json'),'utf8'));
+const install=fs.readFileSync(path.join(root,'desktop/install.command'),'utf8');
+const smoke=fs.readFileSync(path.join(root,'desktop/verify_mac_smoke.command'),'utf8');
+const main=fs.readFileSync(path.join(root,'desktop/app/src/main.js'),'utf8');
+assert.equal(pkg.version,'1.5.14');assert.equal(ext.version,'1.5.14');
+assert(install.includes('SIDEDOCK_VERSION="1.5.14"')&&install.includes('BUILD_NUMBER="1514"'));
+assert(install.includes('INSTALL_RECEIPT_v1514.json'));
+assert(smoke.includes('EXPECTED_VERSION="1.5.14"')&&smoke.includes('EXPECTED_BUILD="1514"'));
+assert(main.includes('SIDEDOCK_V1514_RELEASE_GATE.json')&&main.includes("contract:'sidedock-v1514-release-gate/1'"));
+assert(fs.existsSync(path.join(root,'01_安装_SideDock_v1.5.14.command'));
+assert(fs.existsSync(path.join(root,'02_实机验收_SideDock_v1.5.14.command'));
+console.log('PASS v1.5.14 delivery/version/release-gate contract');
